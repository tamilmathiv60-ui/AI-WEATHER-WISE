          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/locations",
          "host": ["{{baseUrl}}"],
          "path": ["api", "locations"]
        }
      }
    }
  ],
  "variable": [
